<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TopBar.App.SettingsPages.DesktopsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TopBar.App.Controls">
    <ScrollViewer>
        <StackPanel Spacing="8" Padding="36,20,36,36" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="Desktops_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Height="8" />

            <InfoBar x:Name="UnavailableInfo" x:Uid="Desktops_Unavailable" Severity="Warning" IsClosable="False" IsOpen="False" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch x:Name="ScrollSwitch" x:Uid="Desktops_Scroll" Toggled="ScrollSwitch_Toggled" />
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <controls:SliderRow x:Name="DotSizeRow" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
