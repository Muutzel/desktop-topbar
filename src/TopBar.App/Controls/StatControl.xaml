<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TopBar.App.Controls.StatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WarnBrush" Color="{ThemeResource SystemFillColorCaution}" />
        <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource SystemFillColorCritical}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource TextFillColorSecondary}" />
    </UserControl.Resources>
    <!-- The button is built in code (icon, label and value or network table, depending on the kind). -->
    <ContentPresenter x:Name="Host" />
</UserControl>
