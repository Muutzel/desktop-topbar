<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TopBar.App.Controls.PomodoroControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WorkBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="BreakBrush" Color="{ThemeResource SystemFillColorSuccess}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource TextFillColorSecondary}" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Stretch">
        <Button x:Name="MainButton" Style="{StaticResource BarButtonStyle}" Margin="0,4" Click="MainButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="StateIcon" FontFamily="Segoe UI Emoji" FontSize="14" IsColorFontEnabled="False" VerticalAlignment="Center" />
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="SkipButton" Style="{StaticResource BarButtonStyle}" Margin="0,4" Padding="6,0" Visibility="Collapsed" Click="SkipButton_Click">
            <FontIcon FontFamily="{StaticResource SegoeIconsFont}" Glyph="&#xE893;" FontSize="12" />
        </Button>
        <Button x:Name="ResetButton" Style="{StaticResource BarButtonStyle}" Margin="0,4" Padding="6,0" Visibility="Collapsed" Click="ResetButton_Click">
            <FontIcon FontFamily="{StaticResource SegoeIconsFont}" Glyph="&#xE71A;" FontSize="12" />
        </Button>
    </StackPanel>
</UserControl>
