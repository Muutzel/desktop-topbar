<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TopBar.App.Controls.DesktopIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ActiveBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="InactiveBrush" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="HoverBrush" Color="{ThemeResource TextFillColorPrimary}" />
    </UserControl.Resources>
    <StackPanel x:Name="Row" Orientation="Horizontal" Background="Transparent" VerticalAlignment="Stretch" />
</UserControl>
