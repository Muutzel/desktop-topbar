<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TopBar.App.Controls.WeatherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- No location configured: globe button opens the weather settings -->
        <Button x:Name="LocationButton"
                Style="{StaticResource BarButtonStyle}"
                Margin="0,4"
                Visibility="Collapsed"
                Click="LocationButton_Click">
            <FontIcon FontFamily="{StaticResource SegoeIconsFont}" Glyph="&#xE774;" FontSize="14" />
        </Button>

        <StackPanel x:Name="WeatherPanel" Orientation="Horizontal" Spacing="6" Background="Transparent" Visibility="Collapsed">
            <TextBlock x:Name="WeatherIcon" FontFamily="{StaticResource FluentIconsFont}" FontSize="18" VerticalAlignment="Center" />
            <TextBlock x:Name="WeatherText" VerticalAlignment="Center" TextAlignment="Right" />
        </StackPanel>
    </StackPanel>
</UserControl>
