<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TopBar.App.Controls.SystemStatsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WarnBrush" Color="{ThemeResource SystemFillColorCaution}" />
        <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource SystemFillColorCritical}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource TextFillColorSecondary}" />
    </UserControl.Resources>
    <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="12" VerticalAlignment="Stretch">
        <Button x:Name="SettingsButton" Style="{StaticResource BarButtonStyle}" Margin="0,4" Click="SettingsButton_Click">
            <FontIcon FontFamily="{StaticResource SegoeIconsFont}" Glyph="&#xE713;" FontSize="14" />
        </Button>
    </StackPanel>
</UserControl>
